# MongoDB (same database as the Next.js app). Heroku often exposes MONGO_URL.
MONGO_URL=mongodb+srv://...
# MONGODB_URI=mongodb+srv://...

# After each cron run, trigger Web Push evaluation on Vercel
ALERTA_PUSH_CHECK_URL=https://your-app.vercel.app/api/push/check
# Same value as PUSH_WEBHOOK_SECRET on Vercel
PUSH_WEBHOOK_SECRET=
